# Copy to .env and fill in. `docker compose up` reads this file.

# Required: session signing / CSRF secret. Must be >= 32 bytes.
# Generate: openssl rand -base64 48
TESQIVO_SECRET_KEY=

# Required on first boot only: gate for creating the first System Admin.
# Generate: openssl rand -hex 24   (unset it after setup is complete)
TESQIVO_BOOTSTRAP_TOKEN=

# Public base URL the browser uses. Controls cookie Secure flag (https => Secure).
TESQIVO_PUBLIC_URL=http://localhost:8080

# Host port the reverse proxy listens on.
TESQIVO_HTTP_PORT=8080

# PostgreSQL password for the bundled database.
POSTGRES_PASSWORD=change-me-in-production

# --- Optional: outbound email for self-service password reset ---
# Leave TESQIVO_SMTP_HOST unset to disable email. When disabled, the "Forgot
# password?" screen tells users to contact an administrator, and admins can reset
# any account from the users API. Administrator accounts are never emailed a
# temporary password - a human must reset them.
#TESQIVO_SMTP_HOST=smtp.example.com
#TESQIVO_SMTP_PORT=587
#TESQIVO_SMTP_USER=tesqivo@example.com
#TESQIVO_SMTP_PASSWORD=
#TESQIVO_SMTP_FROM=TESQIVO <tesqivo@example.com>
#TESQIVO_SMTP_STARTTLS=true
