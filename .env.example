# TESQIVO configuration. NONE of this is required to try TESQIVO locally -
# `docker compose up -d` works with no .env at all. Copy this file to .env and
# fill in what you need for a real deployment. Full reference: docs/self-hosting.md

# --- recommended for any deployment you keep ---

# PostgreSQL password for the bundled database (default: tesqivo).
POSTGRES_PASSWORD=change-me

# Absolute URL browsers use to reach TESQIVO. Must be https:// for secure cookies.
TESQIVO_PUBLIC_URL=http://localhost:8080

# Host port the app listens on (default 8080). Use 127.0.0.1:8080 to bind locally
# only (e.g. when a separate reverse proxy terminates TLS).
TESQIVO_HTTP_PORT=8080

# --- optional ---

# Session signing / CSRF secret (>= 32 bytes). Leave unset and the container
# generates one on first boot and persists it in the data volume. Set it
# explicitly if you want to manage it yourself or share it across hosts.
# Generate: openssl rand -base64 48
#TESQIVO_SECRET_KEY=

# Pin a specific image version instead of :latest (see the GitHub releases page).
#TESQIVO_VERSION=v0.2.0

# Optional one-time token for the browser "create first admin" screen. The
# supported path is `docker compose exec web python -m app.cli create-admin`,
# which needs no token.
#TESQIVO_BOOTSTRAP_TOKEN=

# --- optional outbound email (self-service password reset) ---
# When set, "Forgot password?" emails a one-time reset link (valid 1 hour; the
# current password keeps working until it is used). When unset, that screen tells
# users to contact an administrator, who resets accounts from the admin console.
# Administrator accounts are never emailed - a human must reset them.
#TESQIVO_SMTP_HOST=smtp.example.com
#TESQIVO_SMTP_PORT=587
#TESQIVO_SMTP_USER=tesqivo@example.com
#TESQIVO_SMTP_PASSWORD=
#TESQIVO_SMTP_FROM=TESQIVO <tesqivo@example.com>
#TESQIVO_SMTP_STARTTLS=true
