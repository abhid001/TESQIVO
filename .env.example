# Copy to .env and fill in. `docker compose up` reads this file.

# Required: session signing / CSRF secret. Must be >= 32 bytes.
# Generate: openssl rand -base64 48
TESQIVO_SECRET_KEY=

# Required on first boot only: gate for creating the first System Admin.
# Generate: openssl rand -hex 24   (unset it after setup is complete)
TESQIVO_BOOTSTRAP_TOKEN=

# Public base URL the browser uses. Controls cookie Secure flag (https => Secure).
TESQIVO_PUBLIC_URL=http://localhost:8080

# Host port the reverse proxy listens on.
TESQIVO_HTTP_PORT=8080

# PostgreSQL password for the bundled database.
POSTGRES_PASSWORD=change-me-in-production
